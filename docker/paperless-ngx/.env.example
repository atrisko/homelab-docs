# ==============================================================================
# PAPERLESS-NGX & LOCAL WORKFLOW ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# --- Paperless-ngx Network Ports ---
PAPERLESS_PORT=8000

# --- Security Keys & Database Credentials ---
# Generate a strong key locally via: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=YOUR_GENERATED_SECRET_KEY
PAPERLESS_DB_PASS=YOUR_DATABASE_PASSWORD

# --- Native AI Cloud Integration (For Real-time UI Document Chat & RAG) ---
# Used for responsive chat in the browser without server GPU bottlenecks
PAPERLESS_AI_MODEL=gemini-1.5-flash
PAPERLESS_AI_ENDPOINT=
PAPERLESS_AI_API_KEY=YOUR_GEMINI_API_KEY

# --- Local AI Integration (Ollama) ---
# Point this to your Unraid host IP running the Ollama container
OLLAMA_HOST=http://YOUR_UNRAID_IP:11434
OLLAMA_MODEL=qwen2.5:8b

# --- Paperless-GPT Middleware ---
GPT_PORT=8080
# Generate this token inside Paperless-ngx Django Admin panel after initial setup
PAPERLESS_API_TOKEN=YOUR_PAPERLESS_REST_API_TOKEN