# ==============================================================================
# PAPERLESS-NGX HYBRID SETUP - CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- General Network Ports ---
PAPERLESS_PORT=8000
GPT_PORT=8080

# --- Security Keys & Database Credentials ---
PAPERLESS_SECRET_KEY=YOUR_GENERATED_SECRET_KEY
PAPERLESS_DBPASS=YOUR_DATABASE_PASSWORD

# --- Requesty Cloud AI ---
PAPERLESS_AI_MODEL=google/gemini-1.5-flash
PAPERLESS_AI_ENDPOINT=https://router.requesty.ai/v1
PAPERLESS_AI_API_KEY=YOUR_REQUESTY_API_KEY

# --- Local Ollama AI ---
OLLAMA_HOST=http://YOUR_UNRAID_IP:11434
OLLAMA_MODEL=qwen2.5:8b

# --- Paperless-GPT Integration ---
PAPERLESS_API_TOKEN=YOUR_PAPERLESS_REST_API_TOKEN