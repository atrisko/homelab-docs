# ==============================================================================
# GITOPS SECRETS CONFIGURATION (Save as .env next to docker-compose.yml)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Unraid Host Paths & Port Bindings
# ------------------------------------------------------------------------------
# Appdata directory on your cache pool (SSD) for lightning-fast database access
UNRAID_APPDATA=/mnt/user/appdata

# Target directories on your parity-protected array (HDD) for document storage
UNRAID_MEDIA_MEDIA=/mnt/user/paperless/media
UNRAID_MEDIA_CONSUME=/mnt/user/paperless-consume
UNRAID_MEDIA_EXPORT=/mnt/user/paperless/export

# External Web UI Ports
PAPERLESS_PORT=8777
GPT_PORT=3002

# ------------------------------------------------------------------------------
# 2. Database Secrets (Mapping to your existing postgresql17 container)
# ------------------------------------------------------------------------------
PAPERLESS_DBHOST=postgresql17
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=your_super_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 3. Paperless Core Security & Localization
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies and sensitive values. Keep it secure!
PAPERLESS_SECRET_KEY=generate_a_random_long_string_here_using_a_password_generator
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu+eng

# ------------------------------------------------------------------------------
# 4. Paperless API Access Token for Paperless-GPT Handoff
# ------------------------------------------------------------------------------
# Generate this token inside Paperless Admin -> Auth Tokens
PAPERLESS_API_TOKEN=your_django_api_auth_token_here

# ------------------------------------------------------------------------------
# 5. Native Paperless-ngx AI / RAG Integration (Version 3.0+)
# ------------------------------------------------------------------------------
# Leave empty if you do not want to use the native RAG chat features
PAPERLESS_AI_MODEL=qwen3:8b
PAPERLESS_AI_ENDPOINT=http://ollama:11434
PAPERLESS_AI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Paperless-GPT LLM & OCR Backend Configuration
# ------------------------------------------------------------------------------

# --- OPTION A: LOCAL INFERENCE (Default Ollama Setup) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://192.168.1.50:11434 # Replace with your GPU server's actual IP
OLLAMA_CONTEXT_LENGTH=4096
TOKEN_LIMIT=2000

# --- OPTION B: CLOUD INFERENCE / API GATEWAY (e.g. Requesty / OpenRouter) ---
# Uncomment these lines and comment out Option A to switch to Cloud LLMs!
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini # Or your preferred model (e.g. gemini-2.5-flash)
# OPENAI_BASE_URL=https://api.requesty.ai/v1 # Or https://openrouter.ai/api/v1
# OPENAI_API_KEY=your_requesty_api_key_here

# --- Vision OCR Settings (iGPU or Dedicated GPU) ---
OCR_PROVIDER=llm
VISION_LLM_PROVIDER=ollama
VISION_LLM_MODEL=minicpm-v
GOOGLEAI_API_KEY= # Optional, if using Gemini for vision tasks

Gemini Notebook kann fehlerhafte Informationen ausgeben. Bitte überprüfen Sie die Antworten.