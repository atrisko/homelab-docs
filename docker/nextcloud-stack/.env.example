# .env
# ENVIRONMENTAL CONFIGURATIONS & PRIVATE SECRETS
# Local to the unRAID host. Avoid committing to Git!

# --- NETWORK & PORTS ---\
# Host port mapping for the Nextcloud web service
NC_PORT=8080

# The exact name of the pre-existing Unraid Docker network where PostgreSQL runs
DOCKER_NETWORK=nextcloud-net

# --- PATHS (UNRAID PERSISTENCE) ---\
# Performance critical config/html storage. Zwingend auf SSD Cache-Pool!
NC_APPDATA_PATH=/mnt/cache/appdata/nextcloud

# Storage-heavy user files. Allocation on the HDD array is safe
NC_DATA_PATH=/mnt/user/nextcloud_data

# --- EXISTING POSTGRESQL DATABASE ---\
# Docker service name or container name of the existing PostgreSQL instance
DB_HOST=my-existing-postgres-container
DB_NAME=nextclouddb
DB_USER=nextcloud_user
DB_PASSWORD=SecureDatabasePassword

# --- INITIAL NEXTCLOUD ADMIN CREATION ---\
# Utilized only during the initial setup wizard to bootstrap the admin account
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=SecureAdminPassword

# --- INITIAL ACCESS SECURITY ---\
# Space-separated list of hostnames/IPs allowed to connect to the instance.
# Inclusion of the local unRAID IP and local WireGuard IP subnet is required
NC_TRUSTED_DOMAINS=192.168.178.100 10.253.0.1 nextcloud.local